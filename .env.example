# ----------------------------------------------------------------              
# PRIMARY APP CONFIGURATION (App-Specific)
# ----------------------------------------------------------------
# These variables are unique to this specific application's business logic.
# Change these when deploying a new app (e.g., Guitar, Piano, etc.)
APP_BASE_URL=https://dummyjson.com
APP_API_KEY=key_auth

# ----------------------------------------------------------------
# CENTRAL HUB CONFIGURATION (Shared/Global)
# ----------------------------------------------------------------
# Centralized system for cross-app services: Ads, Installs, and Analytics.
# These variables remain consistent across the entire app ecosystem.
HUB_BASE_URL=https://api.your-global-service.com
HUB_API_KEY=key_global

# ----------------------------------------------------------------
# Google key
# ----------------------------------------------------------------
GOOGLE_WEB_CLIENT_ID=google_key